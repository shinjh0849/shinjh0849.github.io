---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand display" aria-label="Home">Jiho<em>.</em>Shin</a>
    <nav class="nav-links" aria-label="Primary">
      <span class="nav-pill" aria-hidden="true"></span>
      {nav.map((n) => (
        <a href={n.href} class:list={[{ active: path === n.href }]}>
          <span class="nav-roll"><span>{n.label}</span><span aria-hidden="true">{n.label}</span></span>
        </a>
      ))}
    </nav>
    <div class="nav-right">
      <a class="btn cv" href={site.links.cv} target="_blank" rel="noreferrer" data-magnetic>CV <span class="arrow">↗</span></a>
      <button class="burger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    {nav.map((n) => <a href={n.href} class:list={[{ active: path === n.href }]}>{n.label}</a>)}
    <a href={site.links.cv} target="_blank" rel="noreferrer">CV ↗</a>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 100;
    transition: transform 0.5s var(--ease-out), background 0.4s, border-color 0.4s;
    border-bottom: 1px solid transparent;
  }
  .nav.nav--scrolled { background: rgba(15, 11, 8, 0.72); backdrop-filter: blur(14px); border-color: var(--border); }
  .nav.nav--hidden { transform: translateY(-100%); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; height: 72px; }
  .brand { font-size: 2rem; letter-spacing: -0.01em; transition: color 0.3s; }
  .brand em { color: var(--accent); font-style: normal; display: inline-block; transition: transform 0.4s var(--ease-out); }
  .brand:hover em { transform: translateY(-0.18em) scale(1.3); }
  .nav-links { position: relative; display: flex; gap: 0.15rem; padding: 0.3rem; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); }
  .nav-pill {
    position: absolute; top: 0.3rem; bottom: 0.3rem; left: 0; width: 0; border-radius: 999px;
    background: var(--surface-2); border: 1px solid var(--border-strong); opacity: 0; pointer-events: none;
    transition: left 0.45s var(--ease-out), width 0.45s var(--ease-out), opacity 0.3s;
  }
  .nav-links.pill-on .nav-pill { opacity: 1; }
  .nav-links a {
    position: relative; z-index: 1; padding: 0.55rem 0.95rem; font-size: 0.98rem; font-weight: 500; color: var(--muted);
    border-radius: 999px; transition: color 0.3s; line-height: 1.2;
  }
  .nav-roll { display: block; height: 1.2em; overflow: hidden; }
  .nav-roll span { display: block; transition: transform 0.45s var(--ease-out); }
  .nav-roll span:last-child { color: var(--accent); }
  .nav-links a:hover .nav-roll span { transform: translateY(-100%); }
  .nav-links a:hover { color: var(--text); }
  .nav-links a.active { color: var(--text); }
  .nav-links a.active::after {
    content: ''; position: absolute; left: 50%; bottom: 0.25rem; width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 10px var(--accent); transform: translateX(-50%);
  }
  .nav-right { display: flex; align-items: center; gap: 0.6rem; }
  .cv { padding: 0.55rem 1rem; font-size: 0.85rem; }
  .burger { display: none; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--border-strong); place-items: center; position: relative; }
  .burger span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: var(--text); transition: transform 0.35s var(--ease-out), top 0.35s; }
  .burger span:first-child { top: 16px; }
  .burger span:last-child { top: 24px; }
  .nav.open .burger span:first-child { top: 20px; transform: rotate(45deg); }
  .nav.open .burger span:last-child { top: 20px; transform: rotate(-45deg); }
  .mobile-menu {
    display: none; flex-direction: column; padding: 0.5rem var(--gutter) 1.5rem;
    background: rgba(15, 11, 8, 0.95); backdrop-filter: blur(14px); border-bottom: 1px solid var(--border);
  }
  .mobile-menu a { padding: 0.8rem 0; font-size: 1.4rem; font-family: var(--font-display); border-bottom: 1px solid var(--border); color: var(--muted); }
  .mobile-menu a.active, .mobile-menu a:hover { color: var(--text); }
  @media (max-width: 1100px) {
    .nav-links { display: none; }
    .burger { display: grid; }
    .nav.open .mobile-menu { display: flex; }
    .nav.open { background: rgba(15, 11, 8, 0.95); }
  }
</style>

<script>
  // Sliding pill that follows the hovered nav link (delegated so it survives view transitions).
  const links = () => document.querySelector<HTMLElement>('.nav-links');
  document.addEventListener('mouseover', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('.nav-links a');
    const wrap = links();
    if (!a || !wrap) return;
    const pill = wrap.querySelector<HTMLElement>('.nav-pill');
    if (!pill) return;
    pill.style.left = `${a.offsetLeft}px`;
    pill.style.width = `${a.offsetWidth}px`;
    wrap.classList.add('pill-on');
  });
  document.addEventListener('mouseout', (e) => {
    const wrap = links();
    if (!wrap) return;
    const to = e.relatedTarget as HTMLElement | null;
    if (!to || !to.closest('.nav-links')) wrap.classList.remove('pill-on');
  });

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const burger = t.closest('.burger');
    const nav = document.querySelector('.nav');
    if (!nav) return;
    if (burger) {
      const open = nav.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    } else if (t.closest('.mobile-menu a')) {
      nav.classList.remove('open');
    }
  });
</script>
