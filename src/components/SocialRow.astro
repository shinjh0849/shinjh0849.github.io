---
// Icon buttons for external profiles. Brand glyphs come from simple-icons
// (LinkedIn is not in that package, so its path is inlined).
import { siGooglescholar, siGithub, siOrcid } from 'simple-icons';
import { site } from '../data/site';

const linkedinPath = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const items = [
  { label: 'Google Scholar', href: site.links.scholar, path: siGooglescholar.path, hex: siGooglescholar.hex },
  { label: 'GitHub', href: site.links.github, path: siGithub.path, hex: 'f6efe6' },
  { label: 'LinkedIn', href: site.links.linkedin, path: linkedinPath, hex: '0A66C2' },
  { label: 'ORCID', href: site.links.orcid, path: siOrcid.path, hex: siOrcid.hex },
];

interface Props { class?: string; compact?: boolean; }
const { class: cls, compact = false } = Astro.props;
---
<ul class:list={['social-row', { compact }, cls]} aria-label="Profiles">
  {items.map((i) => (
    <li>
      <a class="social-btn" href={i.href} target="_blank" rel="me noreferrer" aria-label={i.label} title={i.label} data-magnetic style={`--brand: #${i.hex}`}>
        <svg viewBox="0 0 24 24" width={compact ? 22 : 20} height={compact ? 22 : 20} aria-hidden="true"><path d={i.path} fill="currentColor" /></svg>
        <span class="social-label">{i.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .social-row { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .social-btn {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.6rem 0.95rem; border-radius: 999px;
    border: 1px solid var(--border-strong); background: var(--surface);
    color: var(--muted); font-size: 0.86rem; font-weight: 500;
    transition: color 0.3s, border-color 0.3s, background 0.3s, transform 0.3s var(--ease-out);
    will-change: transform;
  }
  .social-btn svg { flex: none; transition: color 0.3s, transform 0.4s var(--ease-out); }
  .social-btn:hover { color: var(--text); border-color: var(--brand); background: color-mix(in srgb, var(--brand) 14%, transparent); }
  .social-btn:hover svg { color: var(--brand); transform: scale(1.15) rotate(-6deg); }
  .social-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .compact .social-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .compact .social-btn { width: 48px; height: 48px; padding: 0; justify-content: center; border-radius: 50%; position: relative; }
  @media (max-width: 480px) { .social-label { display: none; } .social-btn { padding: 0.7rem; } }
</style>
