---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { counts } from '../data/publications';
import { service, highlights, news } from '../data/misc';
import SocialRow from '../components/SocialRow.astro';

const venues = ['ICSE', 'FSE', 'ISSTA', 'MSR', 'ICSME', 'AIware', 'TSE', 'TOSEM', 'APSEC', 'ISSRE', 'ICST', 'KCSE'];
const pcCount = service.filter((g) => g.group !== 'Student Volunteer').reduce((n, g) => n + g.items.length, 0);
const stats = [
  { n: counts.peerReviewed, ...highlights.papers },
  { n: counts.awards, ...highlights.awards },
  { n: counts.preprint, ...highlights.preprints },
  { n: pcCount, ...highlights.service },
];
const kindLabel = { award: 'Award', paper: 'Paper', role: 'Role', talk: 'Talk' };
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker" data-hero-fade>Postdoctoral Research Fellow · York University</p>
        <h1 class="display hero-title" data-split>Building <em>trustworthy</em> AI&nbsp;agents for <em>software&nbsp;engineering</em>.</h1>
        <p class="hero-lead" data-hero-fade>
          I’m Jiho Shin, a postdoc at York University’s Lassonde School of Engineering. I study agentic software
          engineering: how humans work with agents, how agents and tools collaborate, and how reliable LLMs really
          are at generating, testing, and repairing code.
        </p>
        <div class="hero-cta" data-hero-fade>
          <a class="btn primary" href="/publications/" data-magnetic>Publications <span class="arrow">↗</span></a>
          <a class="btn" href="/experience/" data-magnetic>Experience <span class="arrow">↗</span></a>
          <a class="btn" href={site.links.cv} target="_blank" rel="noreferrer" data-magnetic>CV <span class="arrow">↗</span></a>
        </div>
      </div>
      <div class="hero-visual" data-hero-fade>
        <div class="portrait" data-tilt>
          <img src={site.portrait} alt="Portrait of Jiho Shin" width="520" height="520" />
          <div class="portrait-ring"></div>
          <div class="portrait-tag mono">Toronto, ON · Canada</div>
        </div>
        <SocialRow class="hero-social" />
      </div>
    </div>
    <a class="scroll-hint mono" href="#focus" data-hero-fade>Scroll <span>↓</span></a>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...venues, ...venues].map((v) => <span>{v}</span>)}
    </div>
  </div>

  <!-- FOCUS -->
  <section class="section" id="focus">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Research focus</p>
          <h2 class="display section-title">From AI4SE to <em>agentic</em> SE</h2>
        </div>
        <p>Can agents do real software engineering, can people work with them well, and can we trust what comes out?</p>
      </div>
      <div class="grid grid-3" data-stagger>
        <article class="card">
          <span class="card-kicker">01 · Agentic SE</span>
          <h3>Human–agent collaboration</h3>
          <p>How developers interact with coding agents, and how multiple agents and tools coordinate to finish complex engineering tasks.</p>
        </article>
        <article class="card">
          <span class="card-kicker">02 · Trustworthy LLMs for code</span>
          <h3>Testing & evaluation</h3>
          <p>Unit test and oracle generation, retrieval-augmented testing, benchmarks for vulnerability detection, and metrics that actually mean something.</p>
        </article>
        <article class="card">
          <span class="card-kicker">03 · AI4SE foundations</span>
          <h3>Repair, prediction, translation</h3>
          <p>Program repair, explainable defect prediction, code summarization and translation, and the quality of the ML libraries underneath.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="section" id="highlights">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Highlights</p>
          <h2 class="display section-title">By the <em>numbers</em></h2>
        </div>
        <p>A quick read of the research record: papers, recognition, work in the pipeline, and community service.</p>
      </div>
      <ul class="stats-grid" data-stagger>
        {stats.map((s, i) => (
          <li>
            <a class="card stat-card" href={s.href}>
              <span class="stat-index mono">0{i + 1}</span>
              <span class="display stat-n"><span data-counter={s.n}>0</span></span>
              <span class="stat-label">{s.label}</span>
              <span class="stat-detail mono">{s.detail}</span>
              <span class="now-arrow">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- RECENT NEWS -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Recent news</p>
          <h2 class="display section-title">Lately, <em>in short</em></h2>
        </div>
        <a class="btn" href="/publications/" data-magnetic>All publications <span class="arrow">↗</span></a>
      </div>
      <ol class="news" data-stagger>
        {news.map((n) => {
          const ext = n.href?.startsWith('http');
          const Tag = n.href ? 'a' : 'div';
          return (
            <li class="news-item">
              <span class="news-date mono">{n.date}</span>
              <span class="news-dot" aria-hidden="true"></span>
              <Tag class="news-card" href={n.href} target={ext ? '_blank' : undefined} rel={ext ? 'noreferrer' : undefined}>
                <span class={`tag news-tag ${n.kind}`}>{kindLabel[n.kind]}</span>
                <p class="news-text">{n.text}</p>
                {n.href && <span class="news-arrow">↗</span>}
              </Tag>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- BIG WORD -->
  <section class="bigword" aria-hidden="true">
    <div class="bigword-text display" data-hscrub="-10">{Array.from({ length: 5 }, () => 'AGENTIC SE · AI4SE · ').join('')}</div>
  </section>

  <!-- QUICK LINKS -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Explore</p>
          <h2 class="display section-title">Everything <em>else</em></h2>
        </div>
      </div>
      <div class="grid grid-3" data-stagger>
        {[
          ['Career', 'Experience', 'Research, industry, and teaching roles.', '/experience/'],
          ['Academic', 'Education', 'Ph.D. at York; M.Sc. & B.Sc. at Handong.', '/education/'],
          ['Recognition', 'Awards', 'Thesis award, paper awards, fellowships.', '/awards/'],
          ['Talks', 'Talks & Conferences', 'Invited talks and conferences attended.', '/conferences/'],
          ['Community', 'Service', 'Program committees, reviewing, volunteering.', '/service/'],
          ['Photos', 'Gallery', 'Moments from conferences and bootcamps.', '/gallery/'],
        ].map(([k, t, d, href]) => (
          <a class="card now-card" href={href}>
            <span class="card-kicker">{k}</span>
            <h3>{t}</h3>
            <p>{d}</p>
            <span class="now-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { min-height: min(100svh, 860px); display: flex; flex-direction: column; justify-content: center; padding: 6.5rem 0 3.5rem; position: relative; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: 3rem; align-items: center; }
  .hero-title { font-size: clamp(2.4rem, 4.7vw, 4.3rem); margin-top: 1.4rem; max-width: 21ch; }
  .hero-lead { margin-top: 1.8rem; max-width: 52ch; color: var(--muted); font-size: 1.15rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2.2rem; }
  .hero-visual { display: flex; flex-direction: column; align-items: center; gap: 1.6rem; }
  .hero-visual :global(.hero-social) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; width: min(100%, 380px); }
  .hero-visual :global(.hero-social .social-btn) { width: 100%; justify-content: center; padding: 0.75rem 1rem; font-size: 0.92rem; }
  .portrait { position: relative; width: min(100%, 380px); aspect-ratio: 1; border-radius: 28px; transform-style: preserve-3d; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; border-radius: 28px; filter: saturate(0.9) contrast(1.05); }
  .portrait-ring { position: absolute; inset: -14px; border-radius: 36px; border: 1px solid var(--border-strong); transform: translateZ(-30px); background: linear-gradient(135deg, rgba(255,106,26,0.14), transparent 50%, rgba(255,179,71,0.1)); }
  .portrait-tag { position: absolute; left: -1rem; top: 1.5rem; padding: 0.55rem 0.9rem; background: rgba(15,11,8,0.85); border: 1px solid var(--border-strong); border-radius: 8px; color: var(--muted); transform: translateZ(40px); backdrop-filter: blur(8px); }
  .scroll-hint { position: absolute; bottom: 2rem; left: var(--gutter); color: var(--faint); display: inline-flex; gap: 0.5rem; }
  .scroll-hint span { animation: bob 1.6s ease-in-out infinite; display: inline-block; }
  @keyframes bob { 50% { transform: translateY(4px); } }

  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .stat-card { display: grid; gap: 0.35rem; height: 100%; padding-bottom: 2.6rem; color: inherit; }
  .stat-index { color: var(--faint); font-size: 0.7rem; letter-spacing: 0.14em; }
  .stat-n { font-size: clamp(2.8rem, 4.6vw, 4rem); line-height: 1; color: var(--text); margin-top: 0.6rem; }
  .stat-n::after { content: '+'; color: var(--accent); font-size: 0.5em; vertical-align: top; }
  .stat-label { font-size: 1.05rem; color: var(--text); margin-top: 0.4rem; }
  .stat-detail { font-size: 0.68rem; letter-spacing: 0.06em; color: var(--faint); line-height: 1.6; margin-top: 0.3rem; }
  .stat-card:hover .stat-detail { color: var(--accent-2); }

  .now-card { display: block; padding-bottom: 3rem; }
  .now-arrow { position: absolute; right: 1.25rem; bottom: 1.1rem; font-size: 1.4rem; color: var(--faint); transition: all 0.35s var(--ease-out); }
  .now-card:hover .now-arrow { color: var(--accent); transform: translate(3px, -3px); }

  .news { position: relative; display: grid; gap: 0.9rem; padding-left: 0; }
  .news::before { content: ''; position: absolute; left: calc(7rem + 0.45rem); top: 0.6rem; bottom: 0.6rem; width: 1px; background: linear-gradient(to bottom, var(--accent), var(--border) 35%, var(--border) 65%, transparent); }
  .news-item { display: grid; grid-template-columns: 7rem 1rem 1fr; gap: 0 1.25rem; align-items: start; }
  .news-date { color: var(--accent-2); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; padding-top: 1.2rem; text-align: right; }
  .news-dot { position: relative; width: 10px; height: 10px; margin-top: 1.25rem; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); transition: box-shadow 0.35s, background 0.35s; }
  .news-item:hover .news-dot { background: var(--accent); box-shadow: 0 0 0 5px var(--accent-glow); }
  .news-card { position: relative; display: block; padding: 1rem 3rem 1rem 1.25rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: inherit; transition: transform 0.35s var(--ease-out), border-color 0.35s, background 0.35s; }
  a.news-card:hover { transform: translateX(6px); border-color: rgba(255, 106, 26, 0.45); background: var(--surface-2); }
  .news-tag { display: inline-block; margin-bottom: 0.55rem; }
  .news-tag.role { color: var(--accent); border-color: rgba(255, 106, 26, 0.4); }
  .news-tag.paper { color: var(--accent-cool); border-color: rgba(69, 196, 176, 0.4); }
  .news-tag.talk { color: var(--accent-2); border-color: rgba(255, 179, 71, 0.4); }
  .news-text { color: var(--text); font-size: 1rem; line-height: 1.55; }
  .news-arrow { position: absolute; right: 1.1rem; top: 1rem; font-size: 1.2rem; color: var(--faint); transition: all 0.35s var(--ease-out); }
  a.news-card:hover .news-arrow { color: var(--accent); transform: translate(3px, -3px); }
  @media (max-width: 600px) {
    .news::before { left: 0.45rem; top: 0.2rem; }
    .news-item { grid-template-columns: 1rem 1fr; gap: 0 1rem; }
    .news-date { grid-column: 2; text-align: left; padding: 0 0 0.35rem; }
    .news-dot { grid-row: 1 / span 2; margin-top: 0.15rem; }
    .news-card { grid-column: 2; }
  }

  .bigword { overflow: hidden; padding: 1.5rem 0; border-block: 1px solid var(--border); }
  .bigword-text { font-size: clamp(4rem, 10vw, 9rem); white-space: nowrap; color: transparent; -webkit-text-stroke: 1px var(--border-strong); line-height: 1; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; align-items: flex-start; }
    .hero-visual :global(.hero-social) { width: min(100%, 360px); }
    .portrait { width: min(60vw, 260px); }
    /* keep the location tag off the face on small screens: bottom-left over the podium */
    .portrait-tag { top: auto; bottom: 0.9rem; left: 0.75rem; font-size: 0.62rem; padding: 0.45rem 0.7rem; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
