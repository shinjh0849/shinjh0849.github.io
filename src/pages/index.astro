---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { site } from '../data/site';
import { selected, publications } from '../data/publications';

const venues = ['ICSE', 'ISSTA', 'MSR', 'TSE', 'TOSEM', 'APSEC', 'ISSRE', 'ESEC/FSE', 'ICST', 'KCSE', 'JIPS'];
const stats = [
  { n: publications.filter((p) => p.kind !== 'preprint').length, label: 'Peer-reviewed papers' },
  { n: 2, label: 'Distinguished paper awards' },
  { n: 6, label: 'Preprints under review' },
  { n: 9, label: 'Venues served as reviewer / PC' },
];
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker" data-hero-fade>Postdoctoral Research Fellow · Queen’s University</p>
        <h1 class="display hero-title" data-split>Teaching machines to <em>write</em>, <em>test</em>, and <em>trust</em> code.</h1>
        <p class="hero-lead" data-hero-fade>
          I’m Jiho Shin. I build agentic systems for code and test generation, benchmark LLM reliability,
          and study how to make AI-assisted software engineering actually hold up.
        </p>
        <div class="hero-cta" data-hero-fade>
          <a class="btn primary" href="/publications/" data-magnetic>Publications <span class="arrow">↗</span></a>
          <a class="btn" href="/experience/" data-magnetic>Experience <span class="arrow">↗</span></a>
          <a class="btn" href={site.links.cv} target="_blank" rel="noreferrer" data-magnetic>CV <span class="arrow">↗</span></a>
        </div>
      </div>
      <div class="hero-visual" data-hero-fade>
        <div class="portrait" data-tilt>
          <img src={site.portrait} alt="Portrait of Jiho Shin" width="520" height="520" />
          <div class="portrait-ring"></div>
          <div class="portrait-tag mono">Kingston, ON · Canada</div>
        </div>
      </div>
    </div>
    <a class="scroll-hint mono" href="#focus" data-hero-fade>Scroll <span>↓</span></a>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...venues, ...venues].map((v) => <span>{v}</span>)}
    </div>
  </div>

  <!-- FOCUS -->
  <section class="section" id="focus">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Research focus</p>
          <h2 class="display section-title">Two directions, <em>one</em> question</h2>
        </div>
        <p>Can we rely on AI to engineer software, and can we engineer AI we rely on?</p>
      </div>
      <div class="grid grid-3" data-stagger>
        <article class="card">
          <span class="card-kicker">01 · Agentic SE</span>
          <h3>Code & test generation</h3>
          <p>Agents that synthesize code, tests, and repairs from repository signals, closed-loop with execution feedback.</p>
        </article>
        <article class="card">
          <span class="card-kicker">02 · LLM reliability</span>
          <h3>Evaluation & benchmarks</h3>
          <p>Measuring LLMs on code intelligence, vulnerability detection, and neural test-oracle quality. Metrics that mean something.</p>
        </article>
        <article class="card">
          <span class="card-kicker">03 · SE for AI</span>
          <h3>Assurance for ML systems</h3>
          <p>Testing, validating, and hardening ML/DL libraries and the AI workflows that production software depends on.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="container">
      <div class="divider"></div>
      <ul class="stats-grid" data-stagger>
        {stats.map((s) => (
          <li>
            <span class="display stat-n"><span data-counter={s.n}>0</span></span>
            <span class="mono muted">{s.label}</span>
          </li>
        ))}
      </ul>
      <div class="divider"></div>
    </div>
  </section>

  <!-- NOW -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Currently</p>
          <h2 class="display section-title">Where I <em>am</em></h2>
        </div>
      </div>
      <div class="grid grid-2" data-stagger>
        <a class="card now-card" href="/experience/">
          <span class="card-kicker">Research · 2025 –</span>
          <h3>Queen’s University — Postdoctoral Fellow</h3>
          <p>Advising graduate researchers and leading agentic SE studies at the SAIL and MCIS labs.</p>
          <span class="now-arrow">↗</span>
        </a>
        <a class="card now-card" href="/experience/">
          <span class="card-kicker">Industry · 2025</span>
          <h3>Turing — RLEF / CodeGenAgent Lead</h3>
          <p>Built chain-of-thought code data for reinforcement learning with execution feedback and strengthened test-generation agents.</p>
          <span class="now-arrow">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Selected work</p>
          <h2 class="display section-title">Papers I’d <em>start</em> with</h2>
        </div>
        <a class="btn" href="/publications/" data-magnetic>All publications <span class="arrow">↗</span></a>
      </div>
      <ul class="pub-list" data-stagger>
        {selected.map((p) => <PubItem pub={p} />)}
      </ul>
    </div>
  </section>

  <!-- BIG WORD -->
  <section class="bigword" aria-hidden="true">
    <div class="bigword-text display" data-hscrub="-15">AI4SE · SE4AI · AI4SE · SE4AI ·</div>
  </section>

  <!-- QUICK LINKS -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="kicker">Explore</p>
          <h2 class="display section-title">Everything <em>else</em></h2>
        </div>
      </div>
      <div class="grid grid-3" data-stagger>
        {[
          ['Career', 'Experience', 'Research, industry, and teaching roles.', '/experience/'],
          ['Academic', 'Education', 'Ph.D. at York; M.Sc. & B.Sc. at Handong.', '/education/'],
          ['Recognition', 'Awards', 'Fellowships and distinguished papers.', '/awards/'],
          ['Talks', 'Conferences', 'Where I’ve presented and attended.', '/conferences/'],
          ['Community', 'Service', 'Program committees, reviewing, volunteering.', '/service/'],
          ['Photos', 'Gallery', 'Moments from conferences and bootcamps.', '/gallery/'],
        ].map(([k, t, d, href]) => (
          <a class="card now-card" href={href}>
            <span class="card-kicker">{k}</span>
            <h3>{t}</h3>
            <p>{d}</p>
            <span class="now-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 7rem 0 4rem; position: relative; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: 3rem; align-items: center; }
  .hero-title { font-size: clamp(3rem, 7.2vw, 6.4rem); margin-top: 1.4rem; max-width: 12ch; }
  .hero-lead { margin-top: 1.8rem; max-width: 52ch; color: var(--muted); font-size: 1.15rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 2.2rem; }
  .hero-visual { display: flex; justify-content: center; }
  .portrait { position: relative; width: min(100%, 380px); aspect-ratio: 1; border-radius: 28px; transform-style: preserve-3d; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; border-radius: 28px; filter: saturate(0.9) contrast(1.05); }
  .portrait-ring { position: absolute; inset: -14px; border-radius: 36px; border: 1px solid var(--border-strong); transform: translateZ(-30px); background: linear-gradient(135deg, rgba(79,124,255,0.12), transparent 50%, rgba(126,224,195,0.1)); }
  .portrait-tag { position: absolute; left: -1rem; top: 1.5rem; padding: 0.55rem 0.9rem; background: rgba(6,9,26,0.85); border: 1px solid var(--border-strong); border-radius: 8px; color: var(--muted); transform: translateZ(40px); backdrop-filter: blur(8px); }
  .scroll-hint { position: absolute; bottom: 2rem; left: var(--gutter); color: var(--faint); display: inline-flex; gap: 0.5rem; }
  .scroll-hint span { animation: bob 1.6s ease-in-out infinite; display: inline-block; }
  @keyframes bob { 50% { transform: translateY(4px); } }

  .stats { padding: 2rem 0; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding: 2.5rem 0; }
  .stats-grid li { display: grid; gap: 0.4rem; }
  .stat-n { font-size: clamp(2.6rem, 5vw, 4rem); line-height: 1; color: var(--text); }
  .stat-n::after { content: '+'; color: var(--accent-3); font-size: 0.5em; vertical-align: top; }

  .now-card { display: block; padding-bottom: 3rem; }
  .now-arrow { position: absolute; right: 1.25rem; bottom: 1.1rem; font-size: 1.4rem; color: var(--faint); transition: all 0.35s var(--ease-out); }
  .now-card:hover .now-arrow { color: var(--accent-3); transform: translate(3px, -3px); }

  .bigword { overflow: hidden; padding: 3rem 0; border-block: 1px solid var(--border); }
  .bigword-text { font-size: clamp(5rem, 14vw, 13rem); white-space: nowrap; color: transparent; -webkit-text-stroke: 1px var(--border-strong); line-height: 1; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { order: -1; justify-content: flex-start; }
    .portrait { width: min(60vw, 260px); }
    .stats-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
