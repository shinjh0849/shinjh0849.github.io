---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../data/site';
import SocialRow from '../components/SocialRow.astro';
---
<Base title="About" description="Who I am and how I work.">
  <PageHead kicker="About" title="Hi, I’m <em>Jiho</em>." />
  <section class="page-body">
    <div class="container about-grid">
      <div class="about-side" data-reveal>
        <img src={site.portrait} alt="Jiho Shin" class="about-photo" data-tilt />
        <SocialRow class="about-social" />
        <ul class="about-facts mono">
          <li><span>Role</span>Postdoc · York University (Lassonde)</li>
          <li><span>Prev</span>Postdoc · Queen’s University</li>
          <li><span>Ph.D.</span>EECS · York University, 2025</li>
          <li><span>Base</span>{site.location}</li>
        </ul>
      </div>
      <div class="prose">
        <p class="about-lead display" data-reveal>
          I’m a Postdoctoral Research Fellow at the Lassonde School of Engineering, York University, in Toronto.
          My research is on agentic software engineering: how humans interact with agents, and how different agents
          and tools collaborate to carry out complex software engineering tasks.
        </p>

        <h2 class="display" data-reveal>Research focus</h2>
        <ul class="about-list" data-stagger>
          <li><b>Agentic SE.</b> Human–agent interaction, and multi-agent / multi-tool collaboration on end-to-end engineering tasks.</li>
          <li><b>Trustworthy LLMs for code.</b> Reliability of foundation models for text-to-code, unit test and test-oracle (assertion) generation, program repair, code summarization, and code translation.</li>
          <li><b>Explainable defect prediction and SE for AI.</b> Actionable, stable defect predictors; vulnerabilities and checker bugs in ML/DL libraries; benchmarks for vulnerability detection.</li>
        </ul>

        <h2 class="display" data-reveal>Experience highlights</h2>
        <ul class="about-list" data-stagger>
          <li><b>York University</b> — Postdoctoral Research Fellow, Lassonde School of Engineering (May 2026–present).</li>
          <li><b>Queen’s University</b> — Postdoctoral Research Fellow; agentic SE studies at SAIL / MCIS (Sep 2025–Apr 2026).</li>
          <li><b>Turing</b> — RLEF/CodeGenAgent Lead; CoT code data for RL with execution feedback, test-generation agents (2024–2025).</li>
          <li><b>HGS</b> — Applied AI Engineering Intern; Copilot Studio chatbots for hiring and client guidance (2024–2025).</li>
          <li><b>York University</b> — Graduate Research Assistant and Teaching Assistant; AI4SE and SE4AI (2021–2025).</li>
          <li><b>Handong Global University</b> — Graduate Research Assistant and TA; actionable defect prediction, code generation survey (2018–2021).</li>
        </ul>

        <h2 class="display" data-reveal>Education</h2>
        <ul class="about-list" data-stagger>
          <li><b>Ph.D.</b>, Electrical Engineering and Computer Science — York University (2021–2025). Thesis: LLM effectiveness in automated SE. EECS Outstanding Thesis Award, 2026.</li>
          <li><b>M.Sc.</b>, Computer Science and Electrical Engineering — Handong Global University (2019–2021). Thesis: Actionable Defect Prediction.</li>
          <li><b>B.Sc.</b>, Computer Science and Electrical Engineering — Handong Global University (2012–2019); web apps, HCI, computer vision.</li>
        </ul>

        <p data-reveal>
          If you’d like to discuss research, collaborations, or opportunities, reach out via <a href={site.links.github} target="_blank" rel="noreferrer">GitHub</a>, <a href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>, or <a href={site.links.scholar} target="_blank" rel="noreferrer">Google Scholar</a>, or email <span class="email">{site.email}</span>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-grid { display: grid; grid-template-columns: 0.8fr 1.4fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .about-side { position: sticky; top: 6rem; }
  .about-photo { border-radius: 24px; aspect-ratio: 1; object-fit: cover; width: 100%; }
  .about-side :global(.about-social) { margin-top: 1.2rem; }
  .about-facts { margin-top: 1.5rem; display: grid; gap: 0.6rem; color: var(--text); text-transform: none; letter-spacing: 0; font-size: 0.82rem; }
  .about-facts li { display: grid; grid-template-columns: 3.5rem 1fr; padding: 0.6rem 0; border-bottom: 1px solid var(--border); }
  .about-facts span { color: var(--faint); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.68rem; padding-top: 0.15rem; }
  .about-lead { font-size: clamp(1.5rem, 2.8vw, 2.1rem); line-height: 1.35; color: var(--text); }
  .prose h2 { font-size: 2rem; margin-top: 3.5rem; margin-bottom: 1.2rem; }
  .prose h2::before { content: '— '; color: var(--accent); }
  .about-list { display: grid; gap: 0.9rem; color: var(--muted); }
  .about-list li { padding-left: 1.4rem; position: relative; }
  .about-list li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .about-list b { color: var(--text); font-weight: 600; }
  .prose > p:last-child { margin-top: 3rem; color: var(--muted); }
  .email { font-family: var(--font-mono); font-size: 0.9em; color: var(--text); }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } .about-side { position: static; max-width: 320px; } }
</style>
