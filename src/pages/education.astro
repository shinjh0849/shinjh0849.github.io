  <PageHead kicker="Education" title="Degrees across <em>Canada</em> and <em>Korea</em>." lead="Focused on AI/ML for Software Engineering, code generation, and software assurance." />
  <section class="page-body"><div class="container"><Timeline entries={education} /></div></section>
</Base>
